<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/prop_section_icon_size"
                android:layout_height="@dimen/prop_section_icon_size"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_touch_app"
                app:tint="@color/props_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="時鐘功能"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Properties.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="功能模式">
            <AutoCompleteTextView
                android:id="@+id/spClockMode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_inner"
                android:background="@null"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Properties.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="時間格式">
            <AutoCompleteTextView
                android:id="@+id/spClockTimeFormat"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_inner"
                android:background="@null"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/containerCountdownSeconds"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="倒數秒數">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCountdownSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/containerScheduleTime"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="觸發時間（HH:mm）">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScheduleTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="time"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/containerClockTriggerSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="連動值">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTriggerValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="觸發其他元件"
                android:textColor="@color/prop_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="時鐘不發送 MQTT；到點後由勾選的控制元件發送"
                android:textColor="@color/prop_text_secondary"
                android:textSize="11sp"/>
            <LinearLayout
                android:id="@+id/containerClockLinkedComponents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider_line"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/prop_section_icon_size"
                android:layout_height="@dimen/prop_section_icon_size"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_palette"
                app:tint="@color/props_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="視覺外觀"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/propClockColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
