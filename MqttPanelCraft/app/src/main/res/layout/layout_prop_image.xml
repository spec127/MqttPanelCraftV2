<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SECTION 1: INTERACTION & STREAM MODE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_touch_app"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="@string/properties_section_interaction"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Scale Mode moved here -->
        <!-- Scale Mode (Left-Right Cycler) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/prop_image_scale_mode"
                android:textSize="14sp"
                android:textColor="@color/prop_text_primary"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <ImageButton
                    android:id="@+id/btnScalePrev"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/props_primary"/>
                <TextView
                    android:id="@+id/tvScaleValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="適應"
                    android:textColor="@color/props_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <ImageButton
                    android:id="@+id/btnScaleNext"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/props_primary"/>
            </LinearLayout>
        </LinearLayout>


        <!-- Premium Check Rows: Gesture Zoom & Quick Save -->
        <LinearLayout
            android:id="@+id/itemGestureZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_gesture_zoom"
                    android:textColor="@color/prop_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_gesture_zoom_desc"
                    android:textColor="@color/prop_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/checkGestureZoom"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_premium"
                android:visibility="visible"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemQuickSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_quick_save"
                    android:textColor="@color/prop_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_quick_save_desc"
                    android:textColor="@color/prop_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/checkQuickSave"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_premium"
                android:visibility="visible"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 2: VISUAL APPEARANCE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_palette"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="@string/properties_section_appearance"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Row: Rotation Angle (4) & Color Palette (6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties.Compact"
                android:layout_width="0dp"
                android:layout_weight="4"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:hint="@string/prop_image_rotation">
                <AutoCompleteTextView
                    android:id="@+id/spImageRot"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:textSize="12sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Color Palette -->
            <FrameLayout
                android:id="@+id/containerColorPalette"
                android:layout_width="0dp"
                android:layout_weight="6"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">
                <include layout="@layout/layout_prop_generic_color" />
            </FrameLayout>
        </LinearLayout>

        <!-- Premium Check Row: Show Info (在視覺外觀的最下面) -->
        <LinearLayout
            android:id="@+id/itemShowInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_show_info"
                    android:textColor="@color/prop_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_image_show_info_desc"
                    android:textColor="@color/prop_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/checkShowInfo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_premium"
                android:visibility="visible"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
