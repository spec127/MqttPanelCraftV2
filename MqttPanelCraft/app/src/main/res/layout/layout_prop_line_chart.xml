<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section 1: INTERACTION & LOGIC (互動功能) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_touch_app"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_interaction"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 縱軸上下限與單位 (1:1:1) 在資料數上面 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/prop_chart_y_max"
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etYMax"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/prop_chart_y_min"
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etYMin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/prop_chart_unit"
                style="@style/Widget.App.TextInputLayout.Properties">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChartUnit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:maxLines="1"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未輸入上下限則自動適配"
            android:textColor="@color/prop_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- 2. 資料數上限 (單行輸入框 10~1000 筆) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/prop_chart_max_points"
        style="@style/Widget.App.TextInputLayout.Properties"
        android:layout_marginBottom="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMaxPoints"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. 單線多線資料切換按鈕 -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleSeriesMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnModeSingle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeSingle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/prop_chart_mode_single"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeMulti"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/prop_chart_mode_multi"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 4. 多線專用列：左側是圖例底列開關，右側加減數量 (減少高度為 32dp) -->
    <LinearLayout
        android:id="@+id/containerSeriesCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="10"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSeriesListMode"
            android:layout_width="0dp"
            android:layout_weight="7"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnListModeKey">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListModeKey"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="資料標籤"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="11sp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListModeColorOnly"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="色塊"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="11sp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 加減數量操作鈕 (減少高度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_input_outline">

            <ImageView
                android:id="@+id/btnSeriesDec"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_remove"
                android:padding="6dp"
                android:contentDescription="減少序列"/>

            <TextView
                android:id="@+id/tvSeriesCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/prop_text_primary"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <ImageView
                android:id="@+id/btnSeriesInc"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                android:contentDescription="新增序列"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 5. 序列色表與 Key 列表標頭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="2dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:layout_height="wrap_content"
            android:text="序列顏色 (COLOR)"
            android:paddingStart="12dp"
            android:textSize="10sp"
            android:textColor="@color/prop_text_secondary"
            android:letterSpacing="0.05"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/prop_chart_series_key_hint"
            android:paddingStart="12dp"
            android:textSize="10sp"
            android:textColor="@color/prop_text_secondary"
            android:letterSpacing="0.05"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSeriesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"/>

    <!-- 時間戳勾選列移動至多線顏色下方 -->
    <LinearLayout
        android:id="@+id/itemHasTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_phone_time"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_phone_time_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkHasTimestamp"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="invisible"/>
    </LinearLayout>

    <!-- 分隔線 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Section 2: VISUAL APPEARANCE (視覺外觀) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_visual"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 6. 風格下拉與網格顏色選色卡放在同一行，左4右6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="10"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="wrap_content"
            android:hint="@string/prop_chart_style_label"
            style="@style/Widget.App.TextInputLayout.Properties.Compact"
            android:layout_marginEnd="8dp">
            <AutoCompleteTextView
                android:id="@+id/spChartStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="none"
                android:maxLines="1"
                android:textSize="12sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:id="@+id/containerGridColor"
            android:layout_width="0dp"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 7. 顯示標點 (勾選卡片) -->
    <LinearLayout
        android:id="@+id/itemShowDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_show_dots"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_show_dots_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkShowDots"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="visible"/>
    </LinearLayout>

    <!-- 8. 顯示數值 (勾選卡片，代表每筆旁邊有數值) -->
    <LinearLayout
        android:id="@+id/itemShowValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_show_values"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_chart_cb_show_values_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkShowValues"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="invisible"/>
    </LinearLayout>

</LinearLayout>
