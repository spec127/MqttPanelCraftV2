<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Section: VISUAL APPEARANCE (視覺外觀) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_btn_tune"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_visual"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGraphicType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/prop_graphic_type"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_marginBottom="12dp">
        <AutoCompleteTextView
            android:id="@+id/spGraphicType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:maxLines="1"
            android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- SECTION: Shape (Rectangle / Circle) -->
    <LinearLayout
        android:id="@+id/sectionShape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="10"
            android:layout_marginBottom="12dp">
            
            <LinearLayout
                android:id="@+id/containerFillColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <include layout="@layout/layout_prop_generic_color" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerStrokeColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:orientation="vertical">
                <include layout="@layout/layout_prop_generic_color" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_stroke_width"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStrokeWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Only for Rectangle -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCornerRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_corner_radius"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCornerRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- SECTION: Line -->
    <LinearLayout
        android:id="@+id/sectionLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="10"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:id="@+id/containerLineColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:orientation="vertical">
                <include layout="@layout/layout_prop_generic_color" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLineDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_line_direction"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/spLineDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLineStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_line_style"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/spLineStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_stroke_width"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLineThickness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- SECTION: Image -->
    <LinearLayout
        android:id="@+id/sectionImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Using existing custom view for base64 image picking, e.g. ImagePickerView or simple button? 
             Wait, I will just use a button to pick image from gallery and a TextInput for URL. -->
        <TextView
            android:text="@string/prop_graphic_image_source"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
            
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL (若上傳本地圖片將轉為Base64顯示於此)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImageSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="選擇本地圖片"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilScaleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_scale_type"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/spScaleType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_graphic_opacity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:helperText="0 (透明) ~ 100 (不透明)"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</LinearLayout>
