<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Section 1: Interaction (互動功能) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_touch_app"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="互動功能"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgGraphicType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prop_toggle_height"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeShape"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="圖形"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeLine"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="線條"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeImage"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="圖片"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Dynamic Shape Area -->
    <LinearLayout
        android:id="@+id/sectionShape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPolygonEdges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="圖形種類"
            style="@style/Widget.App.TextInputLayout.Properties.DenseDropdown"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/spPolygonEdges"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_compact_inner"
                android:inputType="none"
                android:background="@null"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.example.mqttpanelcraft.ui.views.PolygonEditorView
            android:id="@+id/polygonEditor"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_prop_editor_surface"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>

    <!-- Dynamic Line Area -->
    <LinearLayout
        android:id="@+id/sectionLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="10"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLineStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:hint="樣式"
            style="@style/Widget.App.TextInputLayout.Properties.DenseDropdown"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/spLineStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_compact_inner"
                android:inputType="none"
                android:background="@null"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:hint="粗細"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLineThickness"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_compact_inner"
                android:inputType="numberDecimal"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Dynamic Image Area -->
    <LinearLayout
        android:id="@+id/sectionImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="選擇本地圖片"
            style="@style/Widget.App.Button.Outlined.Properties"
            app:icon="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="12dp"/>

        <com.example.mqttpanelcraft.ui.views.ImageCropperView
            android:id="@+id/imageCropper"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_prop_editor_surface"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_line"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Section 2: Visual Appearance (視覺外觀) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_visual"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgDirection"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prop_toggle_height"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirHorizontal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="水平"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirVertical"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="垂直"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Row 1: Opacity (4) + Fill color (6) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="10">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="4"
            android:hint="@string/prop_graphic_opacity">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOpacity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_compact_inner"
                android:inputType="number"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/containerFillColor"
            layout="@layout/layout_prop_generic_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6" />
    </LinearLayout>

    <!-- Row 2: Stroke width (4) + Stroke color (6) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="10">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="4"
            android:hint="@string/prop_graphic_stroke_width">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStrokeWidth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_compact_inner"
                android:inputType="numberDecimal"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/containerStrokeColor"
            layout="@layout/layout_prop_generic_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemCornerRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="啟用圓角"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="柔化圖形與邊框的轉角"
                android:textColor="@color/prop_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/vCornerRadiusEnabled"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="invisible"/>
    </LinearLayout>

</LinearLayout>
