<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- SECTION 1: INTERACTION & LOGIC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="12dp">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_touch_app"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
            
        <TextView
            android:text="@string/properties_section_interaction"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:letterSpacing="0.05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Bounds & Unit in Interaction (Min, Max, Unit in one row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/prop_label_min"
            android:layout_marginEnd="6dp"
            style="@style/Widget.App.TextInputLayout.Properties">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:text="0"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/prop_label_max"
            android:layout_marginEnd="6dp"
            style="@style/Widget.App.TextInputLayout.Properties">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:text="100"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilScaleUnit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/meter_unit"
            style="@style/Widget.App.TextInputLayout.Properties">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScaleUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Feedback Checkboxes -->
    <LinearLayout
        android:id="@+id/itemShowValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meter_value_panel_title"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meter_value_panel_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkShowValue"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="visible"/>
    </LinearLayout>

    <!-- Threshold Warning Mode Toggle -->
    <LinearLayout
        android:id="@+id/itemThresholdMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meter_threshold_title"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meter_threshold_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkThresholdMode"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="visible"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerThresholdOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <!-- 新設計的左右同排佈局 (Wow Layout)：左側為全變/漸變切換，右側為數量控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- 左右切換按鈕組 (左側 70% 寬) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleThresholdEffect"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_height="40dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnEffectSolid">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEffectSolid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/meter_effect_step"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:textSize="11sp"
                    app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEffectGradient"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/meter_effect_gradient"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:textSize="11sp"
                    app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 數量控制 Stepper 容器 (右側 30% 寬) -->
            <LinearLayout
                android:id="@+id/containerRgbStepper"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_outline"/>
        </LinearLayout>

        <!-- 動態生成的區段列表 -->
        <LinearLayout
            android:id="@+id/containerRgbStates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_line"
        android:layout_marginBottom="16dp" />

    <!-- SECTION 2: APPEARANCE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="12dp">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
            
        <TextView
            android:text="@string/meter_appearance"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:letterSpacing="0.05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- TOP: Orientation Toggle (Horizontal / Vertical) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleOrientation"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnOrientationVert">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrientationHoriz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/prop_btn_orient_horizontal"
                android:textSize="12sp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrientationVert"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/prop_btn_orient_vertical"
                android:textSize="12sp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ROW 2: Style (Left 4) / Color Palette (Right 6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="top"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_weight="4"
                android:layout_height="wrap_content"
                android:hint="@string/prop_hint_style"
                style="@style/Widget.App.TextInputLayout.Properties.Compact"
                android:layout_marginEnd="12dp">
                <AutoCompleteTextView
                    android:id="@+id/spScaleStyle"
                    android:layout_width="match_parent"
                android:layout_height="@dimen/prop_input_height_inner"
                    android:inputType="none"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    android:ellipsize="end"
                android:textSize="@dimen/prop_dropdown_text_size"/>
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/containerThemeColor"
                layout="@layout/layout_prop_generic_color"
                android:layout_width="0dp"
                android:layout_weight="6"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ROW 3: Premium Check Rows styled like Color Palette -->
        <LinearLayout
            android:id="@+id/itemShowTicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_cb_show_ticks"
                    android:textColor="@color/prop_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slider_ticks_desc"
                    android:textColor="@color/prop_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/checkShowTicks"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_premium"
                android:visibility="visible"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemShowBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_prop_item_premium"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_cb_show_bubble"
                    android:textColor="@color/prop_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slider_bubble_desc"
                    android:textColor="@color/prop_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/checkShowBubble"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_premium"
                android:visibility="visible"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
