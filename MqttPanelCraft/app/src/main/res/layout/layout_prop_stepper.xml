<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SECTION 1: INTERACTION (互動功能) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_touch_app"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="@string/properties_section_interaction"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 最小值 (Min) 與 最大值 (Max) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:hint="最小值 (Min)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPropMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="最大值 (Max)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPropMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- 步進量 (Step) 與 當前數值 (Value) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:hint="步進量 (Step)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPropStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="當前數值">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPropValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- 長按連續步進開關 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="長按連續調整"
            android:textSize="11sp"
            android:textColor="@color/prop_text_secondary"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleLongPress"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLongPressTrue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="開啟"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLongPressFalse"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="關閉"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 鬆手發送說明小字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stepper_hint_release_send"
            android:textSize="11sp"
            android:textColor="@color/prop_text_secondary"
            android:alpha="0.7"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"/>

        <!-- 互動功能與視覺外觀分隔線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 2: VISUAL APPEARANCE (視覺外觀) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_palette"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="@string/properties_section_appearance"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 左右比 4:6 (左邊風格 / 右邊調色盤) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:baselineAligned="false">

            <!-- 左邊：外觀風格 4/10 -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Properties.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_gravity="top"
                android:layout_marginEnd="8dp"
                android:hint="@string/stepper_hint_style">

                <AutoCompleteTextView
                    android:id="@+id/tvStepperStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/prop_input_height_inner"
                    android:inputType="none"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 右邊：調色盤 6/10 -->
            <include
                android:id="@+id/containerColorPalette"
                layout="@layout/layout_prop_generic_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_weight="6" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
