<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 來源設定 (Source Type) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="網頁來源設定"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSourceType"
            style="@style/Widget.App.TextInputLayout.Properties.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="來源模式">
            <AutoCompleteTextView
                android:id="@+id/spSourceType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="none"
                android:textSize="12sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUrl"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="網址 (http:// 或 https://)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- HTML Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHtml"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:hint="HTML 代碼">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHtml"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 行為設定 (Behavior) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_touch_app"
                app:tint="@color/props_primary"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:text="行為設定"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/prop_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swEnableInteraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="允許點擊與滑動 (互動)"
            android:textColor="@color/prop_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>
            
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swTransparentBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="背景透明"
            android:textColor="@color/prop_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="自動重新整理間隔 (秒，0代表關閉)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRefreshInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
