<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section 1: INTERACTION & LOGIC (互動功能與模式) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_touch_app"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_interaction"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prop_broadcast_mode_label"
        android:textSize="12sp"
        android:textColor="@color/prop_text_primary"
        android:layout_marginBottom="6dp"/>

    <!-- 廣播模式切換 (TTS / 警報 / 雙重) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleBroadcastMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnModeTts">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeTts"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/prop_broadcast_mode_tts"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAlert"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/prop_broadcast_mode_alert"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeBoth"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/prop_broadcast_mode_both"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 雙重模式說明提示 -->
    <TextView
        android:id="@+id/tvModeTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prop_broadcast_mode_tip"
        android:textSize="11sp"
        android:textColor="#FFAB00"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- 警報音源選擇 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAlertType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/prop_broadcast_alert_type"
        style="@style/Widget.App.TextInputLayout.Properties.Compact"
        android:layout_marginBottom="16dp">
        <AutoCompleteTextView
            android:id="@+id/spAlertType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:maxLines="1"
            android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

        <!-- Remove Section 2 Divider & Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prop_broadcast_voice_label"
            android:textSize="12sp"
            android:textColor="@color/prop_text_primary"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleVoicePitch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="14dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnVoiceNatural">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceLow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/prop_broadcast_voice_low"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceNatural"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/prop_broadcast_voice_natural"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceBrisk"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/prop_broadcast_voice_brisk"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/prop_toggle_corner_radius"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 語速保留單行輸入框 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpeechRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_broadcast_rate_label"
            style="@style/Widget.App.TextInputLayout.Properties"
            android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpeechRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

    <!-- 掛勾接收對象 (與接收框同步聯動) -->
    <TextView
        android:text="@string/prop_broadcast_linked_tip"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/prop_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:id="@+id/containerLinkedComponents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_prop_item_premium"
        android:layout_marginBottom="12dp"/>

    <!-- Section: VISUAL APPEARANCE (視覺外觀) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="8dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/props_primary"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:text="@string/prop_section_visual"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/prop_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:hint="@string/prop_chart_style_label"
            style="@style/Widget.App.TextInputLayout.Properties.Compact"
            android:layout_marginEnd="12dp">
            <AutoCompleteTextView
                android:id="@+id/spStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLines="1"
                android:textSize="13sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:id="@+id/containerColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6">
            <include layout="@layout/layout_prop_generic_color" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemShowText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_prop_item_premium"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_broadcast_show_text"
                android:textColor="@color/prop_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_broadcast_show_text_desc"
                android:textColor="@color/prop_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/checkShowText"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle_premium"
            android:visibility="invisible"/>
    </LinearLayout>

</LinearLayout>
