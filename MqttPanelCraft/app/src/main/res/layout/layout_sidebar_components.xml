<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Grid Toggle REMOVED as per user request -->

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="34dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etSearchComponents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:background="@null"
            android:hint="@string/project_hint_search"
            android:textColorHint="?android:attr/textColorHint"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="13sp"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:drawableTint="?android:attr/textColorPrimary"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- 捲動上界線（搜索框下方格線） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginBottom="0dp"/>

    <!-- ClippedScrollView 嚴格限制 Canvas 邊界，徹底阻止子視圖超出頂部與底部邊線 -->
    <com.example.mqttpanelcraft.ui.views.ClippedScrollView
        android:id="@+id/sidebarScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:clipChildren="true"
        android:overScrollMode="never"
        android:fadingEdgeLength="0dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <!-- Dynamic Content will be injected here by SidebarManager -->

            <!-- Exit App Button (inside scroll) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/project_btn_exit_app"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="24dp"
                app:icon="@drawable/ic_close_white"
                app:iconGravity="textStart"
                app:cornerRadius="8dp"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"/>

        </LinearLayout>
    </com.example.mqttpanelcraft.ui.views.ClippedScrollView>

    <!-- Space for Ad -->
    <FrameLayout
        android:id="@+id/bannerAdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:layout_marginTop="0dp" />

</LinearLayout>
